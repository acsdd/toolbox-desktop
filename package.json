{
  "name": "toolbox",
  "productName": "Toolbox",
  "version": "0.9.3",
  "description": "A customizable Windows toolset",
  "author": "Alpha Team",
  "repository": {
    "type": "git",
    "url": "https://github.com/acsdd/toolbox-desktop.git"
  },
  "homepage": "https://github.com/acsdd/toolbox-desktop#readme",
  "bugs": {
    "url": "https://github.com/acsdd/toolbox-desktop/issues"
  },
  "license": "MIT",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "smoke": "npm run build && electron scripts/smoke.cjs",
    "screenshots": "npm run build && electron scripts/screenshots.cjs",
    "dist": "npm run build && electron-builder --win",
    "release:notes": "node scripts/release-notes.cjs",
    "site:links": "node scripts/check-site-links.cjs website",
    "site:version": "node scripts/inject-site-version.cjs"
  },
  "build": {
    "appId": "com.alpha.toolbox",
    "productName": "Toolbox",
    "copyright": "Copyright © 2026 Alpha Team",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asar": true,
    "compression": "maximum",
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Toolbox",
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.${ext}"
    }
  },
  "dependencies": {
    "@toolbox/widgets": "file:../toolbox-widgets",
    "fast-xml-parser": "^5.12.0",
    "imapflow": "^2.11.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  }
}
